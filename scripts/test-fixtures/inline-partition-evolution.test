# name: inline-partition-evolution
# description: Known baseline gap: flush after partition evolution with pending inline rows
# group: [aux_known_gap]

require ducklake

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/inline_partition_evolution', DATA_INLINING_ROW_LIMIT 100)

statement ok
CREATE TABLE lake.items(id INTEGER, bucket VARCHAR)

statement ok
INSERT INTO lake.items VALUES (1, 'a')

statement ok
ALTER TABLE lake.items SET PARTITIONED BY (bucket)

statement ok
INSERT INTO lake.items VALUES (2, 'b')

statement ok
CALL ducklake_flush_inlined_data('lake')

query I
SELECT count(*) FROM lake.items
----
2
